# ── Отправка заявок с сайта (mailer) ─────────────────────────────
# Данные вашего почтового провайдера для отправки писем.
# Порт 465 → SMTP_SECURE=true (SSL).  Порт 587 → SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.yourprovider.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@polus-servis77.ru          # ящик-отправитель (логин SMTP)
SMTP_PASS=CHANGE_ME_SMTP_PASS                 # пароль ящика / пароль приложения

MAIL_FROM=noreply@polus-servis77.ru           # от кого приходит письмо
MAIL_TO=help@polus-servis77.ru                # куда падают заявки

# Порт сервиса формы внутри контейнера (менять не нужно)
PORT=3000
