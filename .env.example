# ── Database ────────────────────────────────────────────────────
# В Docker хост БД = имя сервиса "postgres" (НЕ localhost!).
# Для локальной разработки (npm run dev) замените postgres → localhost.
# DB_USER/DB_PASS/DB_NAME должны совпадать с логином/паролем/именем в DATABASE_URL.
DATABASE_URL="postgresql://polus:CHANGE_ME_DB_PASS@postgres:5432/polus_servis"
DB_USER=polus
DB_PASS=CHANGE_ME_DB_PASS
DB_NAME=polus_servis

# ── Redis ────────────────────────────────────────────────────────
# В Docker хост = "redis"; для локалки — localhost
REDIS_URL=redis://redis:6379

# ── Auth ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES=7d

# ── SMTP (Nodemailer) — данные вашего почтового провайдера ───────
# Порт 465 → SMTP_SECURE=true (SSL).  Порт 587 → SMTP_SECURE=false (STARTTLS).
# SMTP_USER/SMTP_PASS — логин и пароль (или пароль приложения) ящика-отправителя.
SMTP_HOST=smtp.yourprovider.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@polus-servis77.ru
SMTP_PASS=CHANGE_ME_SMTP_PASS

MAIL_FROM=noreply@polus-servis77.ru
MAIL_TO=help@polus-servis77.ru          # сюда падают заявки с сайта

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Разрешённые источники для CORS (прод-домен)
CORS_ORIGINS=https://polus-servis77.ru,https://www.polus-servis77.ru

# Max file upload size in megabytes
UPLOAD_MAX_MB=10

# ── Payments (Yookassa) ─────────────────────────────────────────
PAYMENT_YOOKASSA_SHOP_ID=
PAYMENT_YOOKASSA_SECRET=

# ── Analytics ────────────────────────────────────────────────────
YANDEX_METRIKA_ID=
