# ── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://polus:secret@localhost:5432/polus_servis"
DB_USER=polus
DB_PASS=secret
DB_NAME=polus_servis

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES=7d

# ── SMTP (Nodemailer) ────────────────────────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@polus-servis77.ru
SMTP_PASS=your_smtp_password

MAIL_FROM=noreply@polus-servis77.ru
MAIL_TO=info@polus-servis77.ru

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,https://polus-servis77.ru

# Max file upload size in megabytes
UPLOAD_MAX_MB=10

# ── Payments (Yookassa) ─────────────────────────────────────────
PAYMENT_YOOKASSA_SHOP_ID=
PAYMENT_YOOKASSA_SECRET=

# ── Analytics ────────────────────────────────────────────────────
YANDEX_METRIKA_ID=
