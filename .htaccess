Options -Indexes
DirectoryIndex index.html

# Block direct access to internal directories
RewriteEngine On
RewriteRule ^src/        - [F,L]
RewriteRule ^migrations/ - [F,L]
RewriteRule ^storage/(?!uploads/) - [F,L]
RewriteRule ^\.env       - [F,L]
RewriteRule ^composer    - [F,L]

# Force HTTPS — uncomment on production
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Route all /api/* requests to api.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api.php [QSA,L]

# Admin SPA — serve index.html for all /admin/* non-file paths
RewriteRule ^admin/?$ admin/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/(.*)$ admin/index.html [L]

# Pass through existing static files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css             "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 month"
  ExpiresByType image/webp           "access plus 1 month"
  ExpiresByType font/woff2           "access plus 1 year"
</IfModule>
